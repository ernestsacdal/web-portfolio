# GitHub — https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# Spotify — https://developer.spotify.com/dashboard (dormant — SpotifyCard/lib kept for a future swap back)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Apple Music — https://developer.apple.com → Keys → create key with MusicKit enabled
# APPLE_MUSIC_PRIVATE_KEY: paste the .p8 contents on one line, newlines escaped as \n
# APPLE_MUSIC_USER_TOKEN: run the dev server and visit http://localhost:3000/apple-auth
APPLE_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_USER_TOKEN=

# Anthropic — https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# Groq — https://console.groq.com/keys (free tier, powers the chat popup)
GROQ_API_KEY=
